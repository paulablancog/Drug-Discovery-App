                        "Information": [
                            {
                                "ReferenceNumber": 1,
                                "Value": {
                                    "StringWithMarkup": [
                                        {
                                            "String": "Evidence from tracer studies in tea indicates that an alternative caffeine biosynthesis pathway via paraxanthine exists in addition to the major pathwayPWY-5037. Partially purification and subsequent characterization of a tea N-methyltransferase showed that 7-methylxanthine is metabolized to theobromine as well as paraxanthine. However its conversion to theobromine is at a 10-fold faster rate than its conversion to paraxanthine. Because of this preferential\nconversion of 7-methylxansine to theobromine, the depicted caffeine biosynthesis via paraxanthine is a minor route [Kato96].  Caffeine synthases characterized from both tea and coffee showed effective conversion of paraxanthine to caffeine [10984041][10364410][12746542][12527364].",
                                            "Markup": [
                                                {
                                                    "Start": 152,
                                                    "Length": 8,
                                                    "URL": "/pathway/BioCyc:META_PWY-5037"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
