            },
            {
                "ReferenceNumber": 33,
                "Value": {
                    "StringWithMarkup": [
                        {
                            "String": "Bethanechol is a synthetic ester structurally and pharmacologically related to acetylcholine. A slowly hydrolyzed muscarinic agonist with no nicotinic effects, bethanechol is generally used to increase smooth muscle tone, as in the GI tract following abdominal surgery or in urinary retention in the absence of obstruction. It may cause hypotension, cardiac rate changes, and bronchial spasms. [PubChem]",
                            "Markup": [
